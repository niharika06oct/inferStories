# Copy to `.env` in this folder:  cp env.example .env
# Then replace CHANGE_ME with the real password (same as in scripts/reset_local_postgres.sql).
# The line below must NOT start with # or DATABASE_URL will be ignored.
#
# From apps/api:  source .venv/bin/activate && pip install -r requirements.txt
# Optional NLP for entity typing: python -m spacy download en_core_web_sm
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
#
DATABASE_URL=postgresql+psycopg://writers_app:123456@localhost:5432/writers_ai_memory

# Optional: AI synopsis for story descriptions (import / "Generate with AI")
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Auth-service (session verify for FastAPI)
AUTH_SERVICE_URL=http://127.0.0.1:4000
AUTH_SERVICE_API_KEY=change-me-same-as-auth-service-env

# Local dev / pytest only — skip Bearer verify (uses AUTH_DEV_USER_ID)
# AUTH_DISABLED=1
# AUTH_DEV_USER_ID=dev-user
