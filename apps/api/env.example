# Copy to `.env` in this folder:  cp env.example .env
# Then replace CHANGE_ME with the real password (same as in scripts/reset_local_postgres.sql).
# The line below must NOT start with # or DATABASE_URL will be ignored.
#
# From apps/api:  source .venv/bin/activate && pip install -r requirements.txt
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
#
DATABASE_URL=postgresql+psycopg://writers_app:123456@localhost:5432/writers_ai_memory
