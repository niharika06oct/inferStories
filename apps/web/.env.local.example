# Where Next.js proxies `/api/upstream/*` (app/api/upstream/[...path]/route.ts).
# Point this at your FastAPI process (often :8001):
API_PROXY_TARGET=http://127.0.0.1:8001
# Optional: max wait for chapter save + OpenAI extraction (ms). Default 180000 (3 min).
# API_PROXY_TIMEOUT_MS=180000
#
# API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: call the API directly from the browser (full URL). Use for deployed API + CORS.
# Leave unset for local dev so the UI uses same-origin `/api/upstream` and avoids CORS.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Where Next.js proxies `/api/auth/*` to better-auth (auth-service dev server).
AUTH_PROXY_TARGET=http://127.0.0.1:4000
# Origin sent to auth-service on proxied requests (match BETTER_AUTH_URL in auth-service).
AUTH_PROXY_ORIGIN=http://localhost:4000
