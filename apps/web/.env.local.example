# Where Next.js proxies `/api/upstream/*` (see apps/web/next.config.ts).
# Default is http://127.0.0.1:8000 — if 8000 is another app (Django, Docker), you will get
# wrong HTML/404s. Point this at your FastAPI process (often :8001):
API_PROXY_TARGET=http://127.0.0.1:8001
#
# API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: call the API directly from the browser (full URL). Use for deployed API + CORS.
# Leave unset for local dev so the UI uses same-origin `/api/upstream` and avoids CORS.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
